# ============================================================
# VPN Manager — Environment Variables
# Copy this file to .env and fill in your values
# ============================================================

# ---- App ----
NODE_ENV=development
PORT=3000
HOST=0.0.0.0

# ---- JWT ----
JWT_SECRET=change-me-super-secret-key-min-32-chars
JWT_EXPIRES_IN=7d

# ---- Node Registration Security ----
# Registration key for auto-registering VPN nodes
# Generate with: openssl rand -hex 32
NODE_REGISTRATION_KEY=

# ---- VPN Hooks Authentication ----
# Token for authenticating VPN hooks (vpn-connect, vpn-disconnect)
# Generate with: openssl rand -hex 32
VPN_TOKEN=

# ---- Admin Account (seeding) ----
# Password for the initial 'admin' user, applied only when the admin is first seeded.
# The installer prompts for this value on a new interactive install. Leave it
# empty to auto-generate a strong random password (printed once in the seed log).
ADMIN_PASSWORD=

# ---- Database ----

# ---- Web (Development only) ----
# In production, Vite static files are served by Fastify (same-origin).
# VITE_API_URL and WEB_URL are ONLY needed for local development.
VITE_API_URL=http://localhost:3000
WEB_URL=http://localhost:5173
