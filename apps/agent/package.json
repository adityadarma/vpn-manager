{
  "name": "@vpn/agent",
  "version": "2.0.0",
  "type": "module",
  "private": true,
  "bin": {
    "vpn-agent": "./dist/index.js"
  },
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsup",
    "start": "node dist/index.js",
    "test": "vitest run --exclude 'test/*.live.test.ts'",
    "test:live": "vitest run test/openvpn.live.test.ts test/wireguard.live.test.ts test/firewall.live.test.ts test/firewall.distro.live.test.ts",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@vpn/shared": "workspace:*",
    "bcryptjs": "^3.0.3",
    "commander": "^15.0.0",
    "dotenv": "^17.4.2",
    "node-cron": "^4.6.0",
    "zod": "^4.6.2"
  },
  "devDependencies": {
    "@types/node": "^24.12.0",
    "@types/node-cron": "^3.0.11",
    "tsx": "^4.23.13",
    "typescript": "^5.9.3",
    "vitest": "^5.0.0"
  }
}
